VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Meta (Facebook) reklam entegrasyonu — bunlar GİZLİ DEĞİL, OAuth dialog
# URL'inde açıkça görünürler. Gerçek gizli değer (META_APP_SECRET) asla
# buraya/istemciye değil, sadece edge function secret'ı olarak sunucuda durur.
VITE_META_APP_ID=your-meta-app-id
VITE_META_CONFIG_ID=your-meta-business-login-config-id

# Online randevu sayfasinin herkese acik adresi (or. https://adapptiv.com).
# Telefon uygulamasinda musteriye gonderilen randevu linki bununla kurulur;
# bos birakilirsa tarayicida sayfanin kendi adresi kullanilir, telefonda link
# gosterilmez.
VITE_PUBLIC_SITE_URL=

# Online randevu formundaki Cloudflare Turnstile dogrulamasi (bos ise gosterilmez)
VITE_TURNSTILE_SITE_KEY=

# Telefon bildirimleri: android/app/google-services.json eklendikten sonra 1 yap
VITE_PUSH_ENABLED=0
