{
  "name": "isletme-oto-mobil",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc -b && oxlint && vitest run && prettier --check .",
    "icons": "node resources/gen-png.cjs && npx @capacitor/assets generate",
    "icons:notification": "node resources/gen-notification-icon.cjs",
    "test:rls": "node scripts/security/run-rls-tests.mjs",
    "test:edge-auth": "node scripts/security/edge-function-auth-check.mjs",
    "android:aab": "node scripts/android-build.mjs bundleRelease",
    "android:apk": "node scripts/android-build.mjs assembleRelease",
    "android:debug": "node scripts/android-build.mjs assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@supabase/supabase-js": "^2.110.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
